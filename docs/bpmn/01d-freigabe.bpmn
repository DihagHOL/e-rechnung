<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_freigabe" targetNamespace="https://e-rechnung.dihag-extern.com/bpmn" exporter="DIHAG BPMN-Generator (scripts/bpmn/generate-bpmn.js)" exporterVersion="2.0">
  <bpmn:collaboration id="Collab_freigabe">
    <bpmn:participant id="P_Frei" name="Eingangsrechnung freigeben (Monitoring und Genehmigungs-Flow je Werk)" processRef="Process_ERechnung_Freigabe" />
  </bpmn:collaboration>
  <bpmn:process id="Process_ERechnung_Freigabe" name="E-Rechnung Eingangsrechnung freigeben" isExecutable="false">
    <bpmn:documentation>Die Kreditorenbuchhaltung trägt im Monitoring Varialnummer, Kontierung und Bestellnummer ein und fordert die Genehmigung an. Ein Flow je Werk schickt die Rechnung mit PDF an den Genehmiger und schreibt die Antwort an die Rechnung. Bei Genehmigung geht auf Wunsch eine Info an die Adresse zum Austragen im abas, bei Ablehnung eine Mail an den, der angefordert hat. Das ersetzt die Eingangsrechnungsliste auf gruppe_wgc. Gilt nur für WGC. ZAI, HOL, LEG, EWA, EIS und DSO genehmigen im SAP.
Eingebunden in: E-Rechnung Rechnungseingang.
Anwender-Ansicht: https://e-rechnung.dihag-extern.com/prozess.html#eingang
Im Einklang mit den Richtlinien: ISMS-Richtlinie Aufbewahrungsfristen und -pflichten
[[rms:policies=119]]</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P_Frei">
      <bpmn:lane id="LB9" name="Kreditorenbuchhaltung"><bpmn:flowNodeRef>G_start</bpmn:flowNodeRef><bpmn:flowNodeRef>G_edit</bpmn:flowNodeRef><bpmn:flowNodeRef>G_anf</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="LS9" name="SharePoint &amp; Monitoring"><bpmn:flowNodeRef>G_set</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="LF9" name="Power Automate"><bpmn:flowNodeRef>G_quit</bpmn:flowNodeRef><bpmn:flowNodeRef>G_send</bpmn:flowNodeRef><bpmn:flowNodeRef>G_gw</bpmn:flowNodeRef><bpmn:flowNodeRef>G_ja</bpmn:flowNodeRef><bpmn:flowNodeRef>G_gwAbas</bpmn:flowNodeRef><bpmn:flowNodeRef>G_abas</bpmn:flowNodeRef><bpmn:flowNodeRef>G_vermerk</bpmn:flowNodeRef><bpmn:flowNodeRef>G_endJa</bpmn:flowNodeRef><bpmn:flowNodeRef>G_nein</bpmn:flowNodeRef><bpmn:flowNodeRef>G_neinMail</bpmn:flowNodeRef><bpmn:flowNodeRef>G_endNein</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="LG9" name="Genehmiger"><bpmn:flowNodeRef>G_pruef</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
      <bpmn:startEvent id="G_start" name="Rechnung zum Buchen bereit"><bpmn:outgoing>Flow_G_start_G_edit</bpmn:outgoing></bpmn:startEvent>
      <bpmn:userTask id="G_edit" name="Varialnummer, Kontierung und Bestellnummer eintragen"><bpmn:incoming>Flow_G_start_G_edit</bpmn:incoming><bpmn:outgoing>Flow_G_edit_G_anf</bpmn:outgoing></bpmn:userTask>
      <bpmn:userTask id="G_anf" name="Genehmiger wählen und Genehmigung anfordern"><bpmn:incoming>Flow_G_edit_G_anf</bpmn:incoming><bpmn:outgoing>Flow_G_anf_G_set</bpmn:outgoing></bpmn:userTask>
      <bpmn:serviceTask id="G_set" name="Anforderung an der Rechnung speichern (Status „In Genehmigung“)"><bpmn:incoming>Flow_G_anf_G_set</bpmn:incoming><bpmn:outgoing>Flow_G_set_G_quit</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:serviceTask id="G_quit" name="Anforderung quittieren"><bpmn:incoming>Flow_G_set_G_quit</bpmn:incoming><bpmn:outgoing>Flow_G_quit_G_send</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:serviceTask id="G_send" name="Genehmigung mit PDF an den Genehmiger senden"><bpmn:incoming>Flow_G_quit_G_send</bpmn:incoming><bpmn:outgoing>Flow_G_send_G_pruef</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:userTask id="G_pruef" name="Rechnung prüfen und genehmigen oder ablehnen"><bpmn:incoming>Flow_G_send_G_pruef</bpmn:incoming><bpmn:outgoing>Flow_G_pruef_G_gw</bpmn:outgoing></bpmn:userTask>
      <bpmn:exclusiveGateway id="G_gw" name="Genehmigt?"><bpmn:incoming>Flow_G_pruef_G_gw</bpmn:incoming><bpmn:outgoing>Flow_G_gw_G_ja</bpmn:outgoing><bpmn:outgoing>Flow_G_gw_G_nein</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:serviceTask id="G_ja" name="Genehmigt, Genehmiger und Kommentar speichern"><bpmn:incoming>Flow_G_gw_G_ja</bpmn:incoming><bpmn:outgoing>Flow_G_ja_G_gwAbas</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:exclusiveGateway id="G_gwAbas" name="Info zum Austragen im abas angegeben?"><bpmn:incoming>Flow_G_ja_G_gwAbas</bpmn:incoming><bpmn:outgoing>Flow_G_gwAbas_G_abas</bpmn:outgoing><bpmn:outgoing>Flow_G_gwAbas_G_endJa</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:serviceTask id="G_abas" name="Info mit PDF an die abas-Adresse senden"><bpmn:incoming>Flow_G_gwAbas_G_abas</bpmn:incoming><bpmn:outgoing>Flow_G_abas_G_vermerk</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:serviceTask id="G_vermerk" name="Info abas gesendet vermerken"><bpmn:incoming>Flow_G_abas_G_vermerk</bpmn:incoming><bpmn:outgoing>Flow_G_vermerk_G_endJa</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:endEvent id="G_endJa" name="genehmigt"><bpmn:incoming>Flow_G_gwAbas_G_endJa</bpmn:incoming><bpmn:incoming>Flow_G_vermerk_G_endJa</bpmn:incoming></bpmn:endEvent>
      <bpmn:serviceTask id="G_nein" name="Abgelehnt und Kommentar speichern"><bpmn:incoming>Flow_G_gw_G_nein</bpmn:incoming><bpmn:outgoing>Flow_G_nein_G_neinMail</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:serviceTask id="G_neinMail" name="Ablehnung an den Anfordernden melden"><bpmn:incoming>Flow_G_nein_G_neinMail</bpmn:incoming><bpmn:outgoing>Flow_G_neinMail_G_endNein</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:endEvent id="G_endNein" name="abgelehnt"><bpmn:incoming>Flow_G_neinMail_G_endNein</bpmn:incoming></bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_G_start_G_edit" sourceRef="G_start" targetRef="G_edit" />
      <bpmn:sequenceFlow id="Flow_G_edit_G_anf" sourceRef="G_edit" targetRef="G_anf" />
      <bpmn:sequenceFlow id="Flow_G_anf_G_set" sourceRef="G_anf" targetRef="G_set" />
      <bpmn:sequenceFlow id="Flow_G_set_G_quit" sourceRef="G_set" targetRef="G_quit" />
      <bpmn:sequenceFlow id="Flow_G_quit_G_send" sourceRef="G_quit" targetRef="G_send" />
      <bpmn:sequenceFlow id="Flow_G_send_G_pruef" sourceRef="G_send" targetRef="G_pruef" />
      <bpmn:sequenceFlow id="Flow_G_pruef_G_gw" sourceRef="G_pruef" targetRef="G_gw" />
      <bpmn:sequenceFlow id="Flow_G_gw_G_ja" sourceRef="G_gw" targetRef="G_ja" name="ja" />
      <bpmn:sequenceFlow id="Flow_G_gw_G_nein" sourceRef="G_gw" targetRef="G_nein" name="nein" />
      <bpmn:sequenceFlow id="Flow_G_ja_G_gwAbas" sourceRef="G_ja" targetRef="G_gwAbas" />
      <bpmn:sequenceFlow id="Flow_G_gwAbas_G_abas" sourceRef="G_gwAbas" targetRef="G_abas" name="ja" />
      <bpmn:sequenceFlow id="Flow_G_gwAbas_G_endJa" sourceRef="G_gwAbas" targetRef="G_endJa" name="nein" />
      <bpmn:sequenceFlow id="Flow_G_abas_G_vermerk" sourceRef="G_abas" targetRef="G_vermerk" />
      <bpmn:sequenceFlow id="Flow_G_vermerk_G_endJa" sourceRef="G_vermerk" targetRef="G_endJa" />
      <bpmn:sequenceFlow id="Flow_G_nein_G_neinMail" sourceRef="G_nein" targetRef="G_neinMail" />
      <bpmn:sequenceFlow id="Flow_G_neinMail_G_endNein" sourceRef="G_neinMail" targetRef="G_endNein" />
      <bpmn:textAnnotation id="GN_start"><bpmn:text>Nur WGC. ZAI, HOL, LEG, EWA, EIS und DSO genehmigen im SAP.</bpmn:text></bpmn:textAnnotation>
      <bpmn:association id="Assoc_GN_start" associationDirection="None" sourceRef="G_start" targetRef="GN_start" />
      <bpmn:textAnnotation id="GN_anf"><bpmn:text>Mehrere Genehmiger mit „;“, dann gilt die erste Antwort. Die abas-Adresse ist je Werk vorbelegt.</bpmn:text></bpmn:textAnnotation>
      <bpmn:association id="Assoc_GN_anf" associationDirection="None" sourceRef="G_anf" targetRef="GN_anf" />
      <bpmn:textAnnotation id="GN_send"><bpmn:text>Ein Flow je Werk, zum Beispiel „Genehmigung WGC (Monitoring)“. Er startet nur, wenn „Genehmigung anfordern“ gesetzt ist. Eine Genehmigung wartet höchstens 30 Tage.</bpmn:text></bpmn:textAnnotation>
      <bpmn:association id="Assoc_GN_send" associationDirection="None" sourceRef="G_send" targetRef="GN_send" />
  </bpmn:process>
