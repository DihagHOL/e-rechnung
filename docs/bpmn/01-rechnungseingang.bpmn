<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_eingang" targetNamespace="https://e-rechnung.dihag-extern.com/bpmn" exporter="DIHAG BPMN-Generator (scripts/bpmn/generate-bpmn.js)" exporterVersion="2.0">
  <bpmn:category id="Cat_G_anhang"><bpmn:categoryValue id="CV_G_anhang" value="wiederholt sich je Anhang (PDF oder XML)" /></bpmn:category>
  <bpmn:collaboration id="Collab_eingang">
    <bpmn:participant id="P_Lief" name="Lieferant" />
    <bpmn:participant id="P_Ein" name="DIHAG · Rechnungseingang (eigener Flow je Werk: WGC, ZAI, HOL, LEG, EWA)" processRef="Process_ERechnung_Eingang" />
    <bpmn:messageFlow id="Msg_P_Lief_A_start" name="Rechnung (PDF oder XML)" sourceRef="P_Lief" targetRef="A_start" />
    <bpmn:messageFlow id="Msg_A_liefMail_P_Lief" name="Zurückweisung oder Abweichung (geplant)" sourceRef="A_liefMail" targetRef="P_Lief" />
    <bpmn:messageFlow id="Msg_D_rej_P_Lief" name="Zurückweisung" sourceRef="D_rej" targetRef="P_Lief" />
    <bpmn:messageFlow id="Msg_D_kred_P_Lief" name="Rückfrage" sourceRef="D_kred" targetRef="P_Lief" />
  </bpmn:collaboration>
  <bpmn:process id="Process_ERechnung_Eingang" name="E-Rechnung Rechnungseingang" isExecutable="false">
    <bpmn:documentation>Eingangsrechnungen kommen per Mail ins Rechnungspostfach des Werks. Ein Flow je Werk (WGC, ZAI, HOL, LEG, EWA) gibt jeden PDF- oder XML-Anhang an den Prüfdienst und legt Original und Prüfergebnis in ERAR_&lt;Werk&gt; ab. WGC übergibt an die Eingangsrechnungsliste, die anderen Werke schicken eine Archiv-Mail ins eigene Postfach. Die Kreditorenbuchhaltung prüft im Monitoring, schätzt sonstige Rechnungen ein, holt die Freigabe ein und bucht.
Anwender-Ansicht: https://e-rechnung.dihag-extern.com/prozess.html#eingang
Im Einklang mit den Richtlinien: ISMS-Richtlinie Aufbewahrungsfristen und -pflichten
[[rms:policies=119]]</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P_Ein">
      <bpmn:lane id="LA" name="Werks-Postfach &amp; Power Automate"><bpmn:flowNodeRef>A_start</bpmn:flowNodeRef><bpmn:flowNodeRef>A_gw</bpmn:flowNodeRef><bpmn:flowNodeRef>A_move</bpmn:flowNodeRef><bpmn:flowNodeRef>A_endArch</bpmn:flowNodeRef><bpmn:flowNodeRef>A_att</bpmn:flowNodeRef><bpmn:flowNodeRef>A_gwErr</bpmn:flowNodeRef><bpmn:flowNodeRef>A_errMail</bpmn:flowNodeRef><bpmn:flowNodeRef>A_liefMail</bpmn:flowNodeRef><bpmn:flowNodeRef>A_gwWerk</bpmn:flowNodeRef><bpmn:flowNodeRef>A_merk</bpmn:flowNodeRef><bpmn:flowNodeRef>A_archSend</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="LB" name="Prüfdienst (Azure)"><bpmn:flowNodeRef>B_intake</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="LC" name="SharePoint &amp; Monitoring"><bpmn:flowNodeRef>C_orig</bpmn:flowNodeRef><bpmn:flowNodeRef>C_meta</bpmn:flowNodeRef><bpmn:flowNodeRef>C_side</bpmn:flowNodeRef><bpmn:flowNodeRef>W_item</bpmn:flowNodeRef><bpmn:flowNodeRef>W_att</bpmn:flowNodeRef><bpmn:flowNodeRef>W_upd</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="LD" name="Kreditorenbuchhaltung"><bpmn:flowNodeRef>D_check</bpmn:flowNodeRef><bpmn:flowNodeRef>D_gw</bpmn:flowNodeRef><bpmn:flowNodeRef>D_4eyes</bpmn:flowNodeRef><bpmn:flowNodeRef>D_800</bpmn:flowNodeRef><bpmn:flowNodeRef>D_rej</bpmn:flowNodeRef><bpmn:flowNodeRef>E_rej</bpmn:flowNodeRef><bpmn:flowNodeRef>D_gwAnn</bpmn:flowNodeRef><bpmn:flowNodeRef>E_rueck</bpmn:flowNodeRef><bpmn:flowNodeRef>D_frei</bpmn:flowNodeRef><bpmn:flowNodeRef>D_gwFrei</bpmn:flowNodeRef><bpmn:flowNodeRef>D_klaer</bpmn:flowNodeRef><bpmn:flowNodeRef>E_abl</bpmn:flowNodeRef><bpmn:flowNodeRef>D_book</bpmn:flowNodeRef><bpmn:flowNodeRef>D_gwRf</bpmn:flowNodeRef><bpmn:flowNodeRef>E_ok</bpmn:flowNodeRef><bpmn:flowNodeRef>D_kred</bpmn:flowNodeRef><bpmn:flowNodeRef>E_kred</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
      <bpmn:startEvent id="A_start" name="Neue Mail mit Anhang im Werks-Postfach"><bpmn:outgoing>Flow_A_start_A_gw</bpmn:outgoing><bpmn:messageEventDefinition id="A_start_def" /></bpmn:startEvent>
      <bpmn:exclusiveGateway id="A_gw" name="Eigene Archiv-Mail („[ARCHIV]“ im Betreff)?"><bpmn:incoming>Flow_A_start_A_gw</bpmn:incoming><bpmn:outgoing>Flow_A_gw_A_move</bpmn:outgoing><bpmn:outgoing>Flow_A_gw_A_att</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:serviceTask id="A_move" name="Archiv-Mail nach „ArchiviertUndGeprueft“ verschieben"><bpmn:incoming>Flow_A_gw_A_move</bpmn:incoming><bpmn:outgoing>Flow_A_move_A_endArch</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:endEvent id="A_endArch" name="einsortiert"><bpmn:incoming>Flow_A_move_A_endArch</bpmn:incoming></bpmn:endEvent>
      <bpmn:serviceTask id="A_att" name="Nur PDF- und XML-Anhänge weitergeben"><bpmn:incoming>Flow_A_gw_A_att</bpmn:incoming><bpmn:outgoing>Flow_A_att_B_intake</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:callActivity id="B_intake" name="Eingangsprüfung (/api/intake)" calledElement="Process_ERechnung_Eingangspruefung"><bpmn:documentation>Unterprozess: E-Rechnung Eingangsprüfung
[[rms:modell=01NH6NP5HCSYDEL23CFRHJT7LB7QUEENHF]]</bpmn:documentation><bpmn:incoming>Flow_A_att_B_intake</bpmn:incoming><bpmn:outgoing>Flow_B_intake_C_orig</bpmn:outgoing></bpmn:callActivity>
      <bpmn:serviceTask id="C_orig" name="Original in ERAR_&lt;Werk&gt; ablegen (Name: Nummer_USt-IdNr)"><bpmn:incoming>Flow_B_intake_C_orig</bpmn:incoming><bpmn:outgoing>Flow_C_orig_C_meta</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:serviceTask id="C_meta" name="Metadaten setzen (Lieferant, Konformität, Buchung, Prüf-Flags, Mail-Vorgang)"><bpmn:incoming>Flow_C_orig_C_meta</bpmn:incoming><bpmn:outgoing>Flow_C_meta_C_side</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:callActivity id="C_side" name="Nebendateien ablegen" calledElement="Process_ERechnung_Nebendateien"><bpmn:documentation>Unterprozess: E-Rechnung Nebendateien ablegen
[[rms:modell=01NH6NP5G7V3KZMFQIXJF23PZ25WTOJAXE]]</bpmn:documentation><bpmn:incoming>Flow_C_meta_C_side</bpmn:incoming><bpmn:outgoing>Flow_C_side_A_gwErr</bpmn:outgoing></bpmn:callActivity>
      <bpmn:exclusiveGateway id="A_gwErr" name="Ergebnis rot oder falsches Werk?"><bpmn:incoming>Flow_C_side_A_gwErr</bpmn:incoming><bpmn:outgoing>Flow_A_gwErr_A_errMail</bpmn:outgoing><bpmn:outgoing>Flow_A_gwErr_A_gwWerk</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:serviceTask id="A_errMail" name="Fehler-Mail an die Werks-Adresse senden"><bpmn:incoming>Flow_A_gwErr_A_errMail</bpmn:incoming><bpmn:outgoing>Flow_A_errMail_A_liefMail</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:serviceTask id="A_liefMail" name="Lieferanten-Mail mit Prüfbericht senden"><bpmn:incoming>Flow_A_errMail_A_liefMail</bpmn:incoming><bpmn:outgoing>Flow_A_liefMail_A_gwWerk</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:exclusiveGateway id="A_gwWerk" name="Welches Werk?"><bpmn:incoming>Flow_A_liefMail_A_gwWerk</bpmn:incoming><bpmn:incoming>Flow_A_gwErr_A_gwWerk</bpmn:incoming><bpmn:outgoing>Flow_A_gwWerk_A_merk</bpmn:outgoing><bpmn:outgoing>Flow_A_gwWerk_W_item</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:serviceTask id="A_merk" name="Datei für die Archiv-Mail vormerken"><bpmn:incoming>Flow_A_gwWerk_A_merk</bpmn:incoming><bpmn:outgoing>Flow_A_merk_A_archSend</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:serviceTask id="A_archSend" name="Archiv-Mail je E-Rechnung an das eigene Postfach senden"><bpmn:incoming>Flow_A_merk_A_archSend</bpmn:incoming><bpmn:outgoing>Flow_A_archSend_D_check</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:serviceTask id="W_item" name="Eintrag in der Eingangsrechnungsliste WGC anlegen"><bpmn:incoming>Flow_A_gwWerk_W_item</bpmn:incoming><bpmn:outgoing>Flow_W_item_W_att</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:serviceTask id="W_att" name="Original und lesbares PDF an den Eintrag anhängen"><bpmn:incoming>Flow_W_item_W_att</bpmn:incoming><bpmn:outgoing>Flow_W_att_W_upd</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:serviceTask id="W_upd" name="Eintrag mit dem Prüfergebnis aktualisieren"><bpmn:incoming>Flow_W_att_W_upd</bpmn:incoming><bpmn:outgoing>Flow_W_upd_D_check</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:userTask id="D_check" name="Rechnung prüfen und im Monitoring als geprüft markieren"><bpmn:incoming>Flow_A_archSend_D_check</bpmn:incoming><bpmn:incoming>Flow_W_upd_D_check</bpmn:incoming><bpmn:outgoing>Flow_D_check_D_gw</bpmn:outgoing></bpmn:userTask>
      <bpmn:exclusiveGateway id="D_gw" name="Buchungsweg laut Prüfergebnis?"><bpmn:incoming>Flow_D_check_D_gw</bpmn:incoming><bpmn:outgoing>Flow_D_gw_D_frei</bpmn:outgoing><bpmn:outgoing>Flow_D_gw_D_4eyes</bpmn:outgoing><bpmn:outgoing>Flow_D_gw_D_800</bpmn:outgoing><bpmn:outgoing>Flow_D_gw_D_rej</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:userTask id="D_4eyes" name="Im Vier-Augen-Prinzip prüfen (Reverse-Charge, innergem., steuerfrei)"><bpmn:incoming>Flow_D_gw_D_4eyes</bpmn:incoming><bpmn:outgoing>Flow_D_4eyes_D_frei</bpmn:outgoing></bpmn:userTask>
      <bpmn:callActivity id="D_800" name="Sonstige Rechnung einschätzen (800.000 €, Kleinbetrag, Ausland)" calledElement="Process_ERechnung_Einschaetzung"><bpmn:documentation>Unterprozess: E-Rechnung Sonstige Rechnung einschätzen</bpmn:documentation><bpmn:incoming>Flow_D_gw_D_800</bpmn:incoming><bpmn:outgoing>Flow_D_800_D_gwAnn</bpmn:outgoing></bpmn:callActivity>
      <bpmn:userTask id="D_rej" name="Nicht buchen, Zurückweisung an den Lieferanten senden"><bpmn:incoming>Flow_D_gw_D_rej</bpmn:incoming><bpmn:outgoing>Flow_D_rej_E_rej</bpmn:outgoing></bpmn:userTask>
      <bpmn:endEvent id="E_rej" name="zurückgewiesen"><bpmn:incoming>Flow_D_rej_E_rej</bpmn:incoming></bpmn:endEvent>
      <bpmn:exclusiveGateway id="D_gwAnn" name="Rechnung angenommen?"><bpmn:incoming>Flow_D_800_D_gwAnn</bpmn:incoming><bpmn:outgoing>Flow_D_gwAnn_D_frei</bpmn:outgoing><bpmn:outgoing>Flow_D_gwAnn_E_rueck</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:endEvent id="E_rueck" name="zurückgesandt (Variante 1)"><bpmn:incoming>Flow_D_gwAnn_E_rueck</bpmn:incoming></bpmn:endEvent>
      <bpmn:callActivity id="D_frei" name="Eingangsrechnung freigeben (Genehmigung)" calledElement="Process_ERechnung_Freigabe"><bpmn:documentation>Unterprozess: E-Rechnung Eingangsrechnung freigeben</bpmn:documentation><bpmn:incoming>Flow_D_gw_D_frei</bpmn:incoming><bpmn:incoming>Flow_D_4eyes_D_frei</bpmn:incoming><bpmn:incoming>Flow_D_gwAnn_D_frei</bpmn:incoming><bpmn:outgoing>Flow_D_frei_D_gwFrei</bpmn:outgoing></bpmn:callActivity>
      <bpmn:exclusiveGateway id="D_gwFrei" name="Freigegeben?"><bpmn:incoming>Flow_D_frei_D_gwFrei</bpmn:incoming><bpmn:outgoing>Flow_D_gwFrei_D_book</bpmn:outgoing><bpmn:outgoing>Flow_D_gwFrei_D_klaer</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:userTask id="D_klaer" name="Ablehnung mit dem Genehmiger klären"><bpmn:incoming>Flow_D_gwFrei_D_klaer</bpmn:incoming><bpmn:outgoing>Flow_D_klaer_E_abl</bpmn:outgoing></bpmn:userTask>
      <bpmn:endEvent id="E_abl" name="nicht gebucht (abgelehnt)"><bpmn:incoming>Flow_D_klaer_E_abl</bpmn:incoming></bpmn:endEvent>
      <bpmn:manualTask id="D_book" name="Im ERP erfassen und buchen"><bpmn:incoming>Flow_D_gwFrei_D_book</bpmn:incoming><bpmn:outgoing>Flow_D_book_D_gwRf</bpmn:outgoing></bpmn:manualTask>
      <bpmn:exclusiveGateway id="D_gwRf" name="Rückfrage-Flag gesetzt?"><bpmn:incoming>Flow_D_book_D_gwRf</bpmn:incoming><bpmn:outgoing>Flow_D_gwRf_E_ok</bpmn:outgoing><bpmn:outgoing>Flow_D_gwRf_D_kred</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:endEvent id="E_ok" name="gebucht"><bpmn:incoming>Flow_D_gwRf_E_ok</bpmn:incoming></bpmn:endEvent>
      <bpmn:userTask id="D_kred" name="Rückfrage an den Lieferanten senden"><bpmn:incoming>Flow_D_gwRf_D_kred</bpmn:incoming><bpmn:outgoing>Flow_D_kred_E_kred</bpmn:outgoing></bpmn:userTask>
      <bpmn:endEvent id="E_kred" name="gebucht, Rückfrage gestellt"><bpmn:incoming>Flow_D_kred_E_kred</bpmn:incoming></bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_A_start_A_gw" sourceRef="A_start" targetRef="A_gw" />
      <bpmn:sequenceFlow id="Flow_A_gw_A_move" sourceRef="A_gw" targetRef="A_move" name="ja" />
      <bpmn:sequenceFlow id="Flow_A_move_A_endArch" sourceRef="A_move" targetRef="A_endArch" />
      <bpmn:sequenceFlow id="Flow_A_gw_A_att" sourceRef="A_gw" targetRef="A_att" name="nein" />
      <bpmn:sequenceFlow id="Flow_A_att_B_intake" sourceRef="A_att" targetRef="B_intake" />
      <bpmn:sequenceFlow id="Flow_B_intake_C_orig" sourceRef="B_intake" targetRef="C_orig" />
      <bpmn:sequenceFlow id="Flow_C_orig_C_meta" sourceRef="C_orig" targetRef="C_meta" />
      <bpmn:sequenceFlow id="Flow_C_meta_C_side" sourceRef="C_meta" targetRef="C_side" />
      <bpmn:sequenceFlow id="Flow_C_side_A_gwErr" sourceRef="C_side" targetRef="A_gwErr" />
      <bpmn:sequenceFlow id="Flow_A_gwErr_A_errMail" sourceRef="A_gwErr" targetRef="A_errMail" name="ja" />
      <bpmn:sequenceFlow id="Flow_A_errMail_A_liefMail" sourceRef="A_errMail" targetRef="A_liefMail" />
      <bpmn:sequenceFlow id="Flow_A_liefMail_A_gwWerk" sourceRef="A_liefMail" targetRef="A_gwWerk" />
      <bpmn:sequenceFlow id="Flow_A_gwErr_A_gwWerk" sourceRef="A_gwErr" targetRef="A_gwWerk" name="nein" />
      <bpmn:sequenceFlow id="Flow_A_gwWerk_A_merk" sourceRef="A_gwWerk" targetRef="A_merk" name="ZAI, HOL, LEG, EWA" />
      <bpmn:sequenceFlow id="Flow_A_gwWerk_W_item" sourceRef="A_gwWerk" targetRef="W_item" name="WGC" />
      <bpmn:sequenceFlow id="Flow_A_merk_A_archSend" sourceRef="A_merk" targetRef="A_archSend" name="nach allen Anhängen" />
      <bpmn:sequenceFlow id="Flow_W_item_W_att" sourceRef="W_item" targetRef="W_att" />
      <bpmn:sequenceFlow id="Flow_W_att_W_upd" sourceRef="W_att" targetRef="W_upd" />
      <bpmn:sequenceFlow id="Flow_A_archSend_D_check" sourceRef="A_archSend" targetRef="D_check" />
      <bpmn:sequenceFlow id="Flow_W_upd_D_check" sourceRef="W_upd" targetRef="D_check" />
      <bpmn:sequenceFlow id="Flow_D_check_D_gw" sourceRef="D_check" targetRef="D_gw" />
      <bpmn:sequenceFlow id="Flow_D_gw_D_frei" sourceRef="D_gw" targetRef="D_frei" name="Automatik" />
      <bpmn:sequenceFlow id="Flow_D_gw_D_4eyes" sourceRef="D_gw" targetRef="D_4eyes" name="manuell" />
      <bpmn:sequenceFlow id="Flow_D_gw_D_800" sourceRef="D_gw" targetRef="D_800" name="unter Vorbehalt" />
      <bpmn:sequenceFlow id="Flow_D_gw_D_rej" sourceRef="D_gw" targetRef="D_rej" name="zurückgewiesen" />
      <bpmn:sequenceFlow id="Flow_D_4eyes_D_frei" sourceRef="D_4eyes" targetRef="D_frei" name="geprüft" />
      <bpmn:sequenceFlow id="Flow_D_800_D_gwAnn" sourceRef="D_800" targetRef="D_gwAnn" />
      <bpmn:sequenceFlow id="Flow_D_gwAnn_D_frei" sourceRef="D_gwAnn" targetRef="D_frei" name="ja" />
      <bpmn:sequenceFlow id="Flow_D_gwAnn_E_rueck" sourceRef="D_gwAnn" targetRef="E_rueck" name="nein" />
      <bpmn:sequenceFlow id="Flow_D_rej_E_rej" sourceRef="D_rej" targetRef="E_rej" />
      <bpmn:sequenceFlow id="Flow_D_frei_D_gwFrei" sourceRef="D_frei" targetRef="D_gwFrei" />
      <bpmn:sequenceFlow id="Flow_D_gwFrei_D_book" sourceRef="D_gwFrei" targetRef="D_book" name="ja" />
      <bpmn:sequenceFlow id="Flow_D_gwFrei_D_klaer" sourceRef="D_gwFrei" targetRef="D_klaer" name="nein" />
      <bpmn:sequenceFlow id="Flow_D_klaer_E_abl" sourceRef="D_klaer" targetRef="E_abl" />
      <bpmn:sequenceFlow id="Flow_D_book_D_gwRf" sourceRef="D_book" targetRef="D_gwRf" />
      <bpmn:sequenceFlow id="Flow_D_gwRf_E_ok" sourceRef="D_gwRf" targetRef="E_ok" name="nein" />
      <bpmn:sequenceFlow id="Flow_D_gwRf_D_kred" sourceRef="D_gwRf" targetRef="D_kred" name="ja" />
      <bpmn:sequenceFlow id="Flow_D_kred_E_kred" sourceRef="D_kred" targetRef="E_kred" />
      <bpmn:textAnnotation id="N_arch"><bpmn:text>ZAI, HOL, LEG, EWA. Schleifenschutz: Die eigene Archiv-Mail kommt hier wieder an und wird nur einsortiert. In diesem Ordner arbeitet die Buchhaltung.</bpmn:text></bpmn:textAnnotation>
      <bpmn:association id="Assoc_N_arch" associationDirection="None" sourceRef="A_move" targetRef="N_arch" />
      <bpmn:textAnnotation id="N_err"><bpmn:text>Eigener Flow „Fehler melden“. Die Adresse je Werk steht unter Einstellungen.</bpmn:text></bpmn:textAnnotation>
      <bpmn:association id="Assoc_N_err" associationDirection="None" sourceRef="A_errMail" targetRef="N_err" />
      <bpmn:textAnnotation id="N_lief"><bpmn:text>Bei Zurückweisung oder Abweichung. Empfänger aus der E-Rechnung. Der Schalter „Lieferantenmails“ steht noch auf aus.</bpmn:text></bpmn:textAnnotation>
      <bpmn:association id="Assoc_N_lief" associationDirection="None" sourceRef="A_liefMail" targetRef="N_lief" />
      <bpmn:textAnnotation id="N_archSend"><bpmn:text>HOL, LEG, EWA: eine Archiv-Mail je E-Rechnung, die übrigen PDFs der Mail kommen mit. ZAI noch je Anhang. Die Originalmail bleibt im Posteingang.</bpmn:text></bpmn:textAnnotation>
      <bpmn:association id="Assoc_N_archSend" associationDirection="None" sourceRef="A_archSend" targetRef="N_archSend" />
      <bpmn:textAnnotation id="N_wgc"><bpmn:text>WGC: bis zur Umstellung auf das Monitoring über die Eingangsrechnungsliste auf gruppe_wgc. Anhänge nur bei grün oder gelb.</bpmn:text></bpmn:textAnnotation>
      <bpmn:association id="Assoc_N_wgc" associationDirection="None" sourceRef="W_item" targetRef="N_wgc" />
      <bpmn:textAnnotation id="N_check"><bpmn:text>„Als geprüft markieren“ speichert, wer wann geprüft hat.</bpmn:text></bpmn:textAnnotation>
      <bpmn:association id="Assoc_N_check" associationDirection="None" sourceRef="D_check" targetRef="N_check" />
      <bpmn:textAnnotation id="N_800"><bpmn:text>Kleinbetrag bis 250 € und Lieferant im Ausland sind ausgenommen. Die Mail an den Lieferanten geht aus dem Werks-Postfach.</bpmn:text></bpmn:textAnnotation>
      <bpmn:association id="Assoc_N_800" associationDirection="None" sourceRef="D_800" targetRef="N_800" />
      <bpmn:textAnnotation id="N_kred"><bpmn:text>Heute schickt die Buchhaltung die Rückfrage selbst. Mit dem Schalter „Lieferantenmails“ übernimmt das der Eingangs-Flow.</bpmn:text></bpmn:textAnnotation>
      <bpmn:association id="Assoc_N_kred" associationDirection="None" sourceRef="D_kred" targetRef="N_kred" />
