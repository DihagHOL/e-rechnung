<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_einschaetzung" targetNamespace="https://e-rechnung.dihag-extern.com/bpmn" exporter="DIHAG BPMN-Generator (scripts/bpmn/generate-bpmn.js)" exporterVersion="2.0">
  <bpmn:collaboration id="Collab_einschaetzung">
    <bpmn:participant id="P_Ein8" name="Sonstige Rechnung einschätzen (800k-Dialog im Monitoring)" processRef="Process_ERechnung_Einschaetzung" />
    <bpmn:participant id="P_Lief8" name="Lieferant" />
    <bpmn:messageFlow id="Msg_E8_send_P_Lief8" name="Ankündigung, Rücksendung oder Akzeptanz" sourceRef="E8_send" targetRef="P_Lief8" />
  </bpmn:collaboration>
  <bpmn:process id="Process_ERechnung_Einschaetzung" name="E-Rechnung Sonstige Rechnung einschätzen" isExecutable="false">
    <bpmn:documentation>Für eine sonstige Rechnung (PDF ohne E-Rechnung) klärt die Kreditorenbuchhaltung im 800k-Dialog des Monitorings, ob der Lieferant eine E-Rechnung schicken muss. Ausgenommen sind Kleinbeträge bis 250 € brutto und Lieferanten im Ausland. Sonst schätzt sie den Vorjahresumsatz des Lieferanten gegen die Grenze von 800.000 € ein, und ein Flow schickt die passende Mail aus dem Werks-Postfach. Einschätzung, Bestätigungen und Mailaufträge stehen im Lieferantenregister und in der Liste KreditorMails.
Eingebunden in: E-Rechnung Rechnungseingang.
Anwender-Ansicht: https://e-rechnung.dihag-extern.com/prozess.html#eingang
Im Einklang mit den Richtlinien: ISMS-Richtlinie Aufbewahrungsfristen und -pflichten
[[rms:policies=119]]</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P_Ein8">
      <bpmn:lane id="LM8" name="SharePoint &amp; Monitoring"><bpmn:flowNodeRef>E8_start</bpmn:flowNodeRef><bpmn:flowNodeRef>E8_reg</bpmn:flowNodeRef><bpmn:flowNodeRef>E8_aus</bpmn:flowNodeRef><bpmn:flowNodeRef>E8_vorl</bpmn:flowNodeRef><bpmn:flowNodeRef>E8_auftrag</bpmn:flowNodeRef><bpmn:flowNodeRef>E8_status</bpmn:flowNodeRef><bpmn:flowNodeRef>E8_gwVar</bpmn:flowNodeRef><bpmn:flowNodeRef>E8_endRueck</bpmn:flowNodeRef><bpmn:flowNodeRef>E8_endOk</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="LK8" name="Kreditorenbuchhaltung"><bpmn:flowNodeRef>E8_lief</bpmn:flowNodeRef><bpmn:flowNodeRef>E8_gwKlein</bpmn:flowNodeRef><bpmn:flowNodeRef>E8_klein</bpmn:flowNodeRef><bpmn:flowNodeRef>E8_endKlein</bpmn:flowNodeRef><bpmn:flowNodeRef>E8_gwAus</bpmn:flowNodeRef><bpmn:flowNodeRef>E8_ausBest</bpmn:flowNodeRef><bpmn:flowNodeRef>E8_endAus</bpmn:flowNodeRef><bpmn:flowNodeRef>E8_umsatz</bpmn:flowNodeRef><bpmn:flowNodeRef>E8_mail</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="LP8" name="Power Automate (Werks-Postfach)"><bpmn:flowNodeRef>E8_send</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
      <bpmn:startEvent id="E8_start" name="Sonstige Rechnung unter Vorbehalt"><bpmn:outgoing>Flow_E8_start_E8_reg</bpmn:outgoing></bpmn:startEvent>
      <bpmn:serviceTask id="E8_reg" name="Lieferant im Lieferantenregister nachschlagen"><bpmn:incoming>Flow_E8_start_E8_reg</bpmn:incoming><bpmn:outgoing>Flow_E8_reg_E8_aus</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:serviceTask id="E8_aus" name="Hinweise auf Ausland prüfen (Land im Kopf, IBAN, USt-IdNr.)"><bpmn:incoming>Flow_E8_reg_E8_aus</bpmn:incoming><bpmn:outgoing>Flow_E8_aus_E8_lief</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:userTask id="E8_lief" name="Lieferant prüfen und bestätigen"><bpmn:incoming>Flow_E8_aus_E8_lief</bpmn:incoming><bpmn:outgoing>Flow_E8_lief_E8_gwKlein</bpmn:outgoing></bpmn:userTask>
      <bpmn:exclusiveGateway id="E8_gwKlein" name="Kleinbetrag bis 250 € brutto?"><bpmn:incoming>Flow_E8_lief_E8_gwKlein</bpmn:incoming><bpmn:outgoing>Flow_E8_gwKlein_E8_klein</bpmn:outgoing><bpmn:outgoing>Flow_E8_gwKlein_E8_gwAus</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:userTask id="E8_klein" name="Kleinbetrag bestätigen"><bpmn:incoming>Flow_E8_gwKlein_E8_klein</bpmn:incoming><bpmn:outgoing>Flow_E8_klein_E8_endKlein</bpmn:outgoing></bpmn:userTask>
      <bpmn:endEvent id="E8_endKlein" name="ausgenommen: Kleinbetrag"><bpmn:incoming>Flow_E8_klein_E8_endKlein</bpmn:incoming></bpmn:endEvent>
      <bpmn:exclusiveGateway id="E8_gwAus" name="Lieferant im Ausland?"><bpmn:incoming>Flow_E8_gwKlein_E8_gwAus</bpmn:incoming><bpmn:outgoing>Flow_E8_gwAus_E8_ausBest</bpmn:outgoing><bpmn:outgoing>Flow_E8_gwAus_E8_umsatz</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:userTask id="E8_ausBest" name="Ausland bestätigen"><bpmn:incoming>Flow_E8_gwAus_E8_ausBest</bpmn:incoming><bpmn:outgoing>Flow_E8_ausBest_E8_endAus</bpmn:outgoing></bpmn:userTask>
      <bpmn:endEvent id="E8_endAus" name="ausgenommen: Lieferant im Ausland"><bpmn:incoming>Flow_E8_ausBest_E8_endAus</bpmn:incoming></bpmn:endEvent>
      <bpmn:userTask id="E8_umsatz" name="Vorjahresumsatz des Lieferanten einschätzen (über oder bis 800.000 €)"><bpmn:incoming>Flow_E8_gwAus_E8_umsatz</bpmn:incoming><bpmn:outgoing>Flow_E8_umsatz_E8_vorl</bpmn:outgoing></bpmn:userTask>
      <bpmn:serviceTask id="E8_vorl" name="Vorlage nach Rechnungsjahr und Einschätzung vorschlagen"><bpmn:incoming>Flow_E8_umsatz_E8_vorl</bpmn:incoming><bpmn:outgoing>Flow_E8_vorl_E8_mail</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:userTask id="E8_mail" name="Mail prüfen und „Speichern und senden“ wählen"><bpmn:incoming>Flow_E8_vorl_E8_mail</bpmn:incoming><bpmn:outgoing>Flow_E8_mail_E8_auftrag</bpmn:outgoing></bpmn:userTask>
      <bpmn:serviceTask id="E8_auftrag" name="Mailauftrag in der Liste KreditorMails anlegen"><bpmn:incoming>Flow_E8_mail_E8_auftrag</bpmn:incoming><bpmn:outgoing>Flow_E8_auftrag_E8_send</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:serviceTask id="E8_send" name="Mail aus dem Werks-Postfach senden"><bpmn:incoming>Flow_E8_auftrag_E8_send</bpmn:incoming><bpmn:outgoing>Flow_E8_send_E8_status</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:serviceTask id="E8_status" name="Status setzen, „Lieferant informiert“ an der Rechnung zeigen"><bpmn:incoming>Flow_E8_send_E8_status</bpmn:incoming><bpmn:outgoing>Flow_E8_status_E8_gwVar</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:exclusiveGateway id="E8_gwVar" name="Vorlage Variante 1 (Rücksendung)?"><bpmn:incoming>Flow_E8_status_E8_gwVar</bpmn:incoming><bpmn:outgoing>Flow_E8_gwVar_E8_endRueck</bpmn:outgoing><bpmn:outgoing>Flow_E8_gwVar_E8_endOk</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:endEvent id="E8_endRueck" name="Rechnung zurückgesandt"><bpmn:incoming>Flow_E8_gwVar_E8_endRueck</bpmn:incoming></bpmn:endEvent>
      <bpmn:endEvent id="E8_endOk" name="Rechnung angenommen, Lieferant informiert"><bpmn:incoming>Flow_E8_gwVar_E8_endOk</bpmn:incoming></bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_E8_start_E8_reg" sourceRef="E8_start" targetRef="E8_reg" />
      <bpmn:sequenceFlow id="Flow_E8_reg_E8_aus" sourceRef="E8_reg" targetRef="E8_aus" />
      <bpmn:sequenceFlow id="Flow_E8_aus_E8_lief" sourceRef="E8_aus" targetRef="E8_lief" />
      <bpmn:sequenceFlow id="Flow_E8_lief_E8_gwKlein" sourceRef="E8_lief" targetRef="E8_gwKlein" />
      <bpmn:sequenceFlow id="Flow_E8_gwKlein_E8_klein" sourceRef="E8_gwKlein" targetRef="E8_klein" name="ja" />
      <bpmn:sequenceFlow id="Flow_E8_klein_E8_endKlein" sourceRef="E8_klein" targetRef="E8_endKlein" />
      <bpmn:sequenceFlow id="Flow_E8_gwKlein_E8_gwAus" sourceRef="E8_gwKlein" targetRef="E8_gwAus" name="nein" />
      <bpmn:sequenceFlow id="Flow_E8_gwAus_E8_ausBest" sourceRef="E8_gwAus" targetRef="E8_ausBest" name="ja" />
      <bpmn:sequenceFlow id="Flow_E8_ausBest_E8_endAus" sourceRef="E8_ausBest" targetRef="E8_endAus" />
      <bpmn:sequenceFlow id="Flow_E8_gwAus_E8_umsatz" sourceRef="E8_gwAus" targetRef="E8_umsatz" name="nein" />
      <bpmn:sequenceFlow id="Flow_E8_umsatz_E8_vorl" sourceRef="E8_umsatz" targetRef="E8_vorl" />
      <bpmn:sequenceFlow id="Flow_E8_vorl_E8_mail" sourceRef="E8_vorl" targetRef="E8_mail" />
      <bpmn:sequenceFlow id="Flow_E8_mail_E8_auftrag" sourceRef="E8_mail" targetRef="E8_auftrag" />
      <bpmn:sequenceFlow id="Flow_E8_auftrag_E8_send" sourceRef="E8_auftrag" targetRef="E8_send" />
      <bpmn:sequenceFlow id="Flow_E8_send_E8_status" sourceRef="E8_send" targetRef="E8_status" />
      <bpmn:sequenceFlow id="Flow_E8_status_E8_gwVar" sourceRef="E8_status" targetRef="E8_gwVar" />
      <bpmn:sequenceFlow id="Flow_E8_gwVar_E8_endRueck" sourceRef="E8_gwVar" targetRef="E8_endRueck" name="ja" />
      <bpmn:sequenceFlow id="Flow_E8_gwVar_E8_endOk" sourceRef="E8_gwVar" targetRef="E8_endOk" name="nein" />
      <bpmn:textAnnotation id="EN8_aus"><bpmn:text>Aus dem Text der Rechnung, bei Scans per Texterkennung. Die IBAN zählt nur mit gültiger Prüfziffer und hinter „IBAN“.</bpmn:text></bpmn:textAnnotation>
      <bpmn:association id="Assoc_EN8_aus" associationDirection="None" sourceRef="E8_aus" targetRef="EN8_aus" />
      <bpmn:textAnnotation id="EN8_vorl"><bpmn:text>Rechnungsjahr 2026: Ankündigung oder Hinweis. 2027: über 800.000 € Variante 1 (Rücksendung), bis 800.000 € Variante 2 (Akzeptanz). Ab 2028 gilt die Pflicht für alle.</bpmn:text></bpmn:textAnnotation>
      <bpmn:association id="Assoc_EN8_vorl" associationDirection="None" sourceRef="E8_mail" targetRef="EN8_vorl" />
      <bpmn:textAnnotation id="EN8_send"><bpmn:text>Flow „Kreditor-Mail senden“. Das Postfach je Werk steht im Flow, nicht in der Liste.</bpmn:text></bpmn:textAnnotation>
      <bpmn:association id="Assoc_EN8_send" associationDirection="None" sourceRef="E8_send" targetRef="EN8_send" />
  </bpmn:process>
